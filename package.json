{
  "name": "@xcye/corio-capability-openai",
  "version": "1.0.4",
  "description": "Corio capability extension for OpenAI-compatible image, speech and video APIs",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./corio.manifest.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "corio.manifest.json",
    "CORIO_USAGE.md",
    ".agents",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "@xcye/corio-plugin-sdk": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
